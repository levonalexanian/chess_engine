{
    "version": 3,
    "cmakeMinimumRequired": {
        "major": 3,
        "minor": 21,
        "patch": 0
    },
    "configurePresets": [
        {
            "name": "dev",
            "displayName": "Dev (Ninja + Conan toolchain)",
            "description": "Default in-container dev configuration. Run `conan install backend --output-folder=backend/build/dev --build=missing -s build_type=Release` first.",
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/build/dev",
            "toolchainFile": "${sourceDir}/build/dev/conan_toolchain.cmake",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release",
                "CMAKE_POLICY_DEFAULT_CMP0091": "NEW"
            }
        }
    ],
    "buildPresets": [
        {
            "name": "dev",
            "configurePreset": "dev"
        }
    ],
    "testPresets": [
        {
            "name": "dev",
            "configurePreset": "dev",
            "output": {
                "outputOnFailure": true
            }
        }
    ]
}
